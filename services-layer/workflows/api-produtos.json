      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "const r = $input.first().json;\nif (!r.ok) {\n  return [{ json: { estado: r.estadoHTTP, corpo: { erro: \"Não foi possível consultar os produtos.\", codigo: `MOLONI_${r.tipo}` } } }];\n}\n\nconst operacao = r.data?.products;\nif (operacao?.errors?.length) {\n  return [{ json: { estado: 502, corpo: { erro: \"O Moloni ON devolveu erros na consulta de produtos.\" } } }];\n}\n\nconst produtos = operacao?.data;\nif (!Array.isArray(produtos)) {\n  return [{ json: { estado: 502, corpo: { erro: \"Resposta inesperada do Moloni ON.\" } } }];\n}\nreturn [{ json: { estado: 200, corpo: { total: produtos.length, produtos } } }];\n"
      },
