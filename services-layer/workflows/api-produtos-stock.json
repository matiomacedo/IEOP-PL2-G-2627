    {
      "name": "Formatar resposta",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "const r = $input.first().json;\nif (!r.ok) {\n  return [{ json: { estado: r.estadoHTTP, corpo: { erro: \"Não foi possível consultar o stock dos produtos.\", codigo: `MOLONI_${r.tipo}` } } }];\n}\n\nconst operacao = r.data?.products;\nif (operacao?.errors?.length) {\n  return [{ json: { estado: 502, corpo: { erro: \"O Moloni ON devolveu erros na consulta de stock.\" } } }];\n}\n\nif (!Array.isArray(operacao?.data)) {\n  return [{ json: { estado: 502, corpo: { erro: \"Resposta inesperada do Moloni ON.\" } } }];\n}\nconst produtos = operacao.data\n  .filter((produto) => produto.hasStock === true)\n  .map((produto) => ({\n    productId: produto.productId,\n    name: produto.name,\n    reference: produto.reference,\n    stockAtual: produto.stock,\n    stockMinimo: produto.minStock,\n  }));\nreturn [{ json: { estado: 200, corpo: { total: produtos.length, produtos } } }];\n"
      },
      "id": "afab5540-b000-57cc-9be2-0f58950e5a67",
      "position": [
