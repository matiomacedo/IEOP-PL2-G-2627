      "name": "Validar pedido",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "const nif = $input.first().json.query.nif;\nif (typeof nif !== \"string\" || !nif.trim()) {\n  return [{ json: { estado: 400, corpo: { erro: \"O parâmetro nif é obrigatório.\" } } }];\n}\nreturn [{ json: { query: `\n  query ($companyId: Int!, $nif: String!) {\n    customers(\n      companyId: $companyId\n      options: { search: { field: vat, value: $nif }, pagination: { page: 1, qty: 20 } }\n    ) {\n      errors { field msg }\n      data { customerId name vat number }\n    }\n  }`, variables: { nif: nif.trim() } } }];"
      },
      "id": "34140813-0191-52d8-bebc-e8f53ae419ef",
      "position": [
        240,
        0
      ]
    },
