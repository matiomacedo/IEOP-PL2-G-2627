    {
      "name": "Formatar resposta",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "const r = $input.first().json;\nif (!r.ok) {\n  return [{ json: { estado: r.estadoHTTP, corpo: { erro: \"Não foi possível consultar os clientes.\", codigo: `MOLONI_${r.tipo}` } } }];\n}\n\nconst operacao = r.data?.customers;\nif (operacao?.errors?.length) {\n  return [{ json: { estado: 502, corpo: { erro: \"O Moloni ON devolveu erros na consulta de clientes.\" } } }];\n}\n\nconst clientes = operacao?.data;\nif (!Array.isArray(clientes)) {\n  return [{ json: { estado: 502, corpo: { erro: \"Resposta inesperada do Moloni ON.\" } } }];\n}\nreturn [{ json: { estado: 200, corpo: { total: clientes.length, clientes } } }];\n"
      },
      "id": "ec002efb-173b-5b8a-93d5-5ea191bc6b00",
