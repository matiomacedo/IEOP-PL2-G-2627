    {
      "name": "Formatar resposta",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "const r = $input.first().json;\nif (!r.ok) {\n  return [{ json: { estado: r.estadoHTTP, corpo: { erro: \"Não foi possível consultar o stock do produto.\", codigo: `MOLONI_${r.tipo}` } } }];\n}\n\nconst operacao = r.data?.product;\nif (operacao?.errors?.length) {\n  return [{ json: { estado: 502, corpo: { erro: \"O Moloni ON devolveu erros na consulta de stock.\" } } }];\n}\n\nconst produto = operacao?.data;\nif (!produto || typeof produto !== \"object\") {\n  return [{ json: { estado: 404, corpo: { erro: \"Produto não encontrado.\" } } }];\n}\nreturn [{ json: { estado: 200, corpo: {\n  productId: produto.productId,\n  name: produto.name,\n  hasStock: produto.hasStock,\n  stockAtual: produto.stock,\n  stockMinimo: produto.minStock,\n  armazens: (produto.warehouses || []).map((armazem) => ({\n    warehouseId: armazem.warehouseId,\n    stockAtual: armazem.stock,\n    stockMinimo: armazem.minStock,\n  })),\n} } }];\n"
      },
      "id": "78a9d4ab-d0dc-528f-a6fb-337d9cae4740",
      "position": [
        960,
        0
      ]
    },
