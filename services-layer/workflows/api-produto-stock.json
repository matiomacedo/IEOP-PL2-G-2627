    {
      "name": "Validar pedido",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "const productId = Number($input.first().json.query.id);\nif (!Number.isSafeInteger(productId) || productId <= 0) {\n  return [{ json: { estado: 400, corpo: { erro: \"O identificador do produto deve ser um número inteiro positivo.\" } } }];\n}\nreturn [{ json: { query: `\n  query ($companyId: Int!, $productId: Int!) {\n    product(companyId: $companyId, productId: $productId) {\n      errors { field msg }\n      data {\n        productId name hasStock stock minStock\n        warehouses { warehouseId stock minStock }\n      }\n    }\n  }`, variables: { productId } } }];"
      },
      "id": "3b251e03-a302-5a1f-9ecf-2c8accc3056a",
      "position": [
        240,
        0
      ]
    },
    {
