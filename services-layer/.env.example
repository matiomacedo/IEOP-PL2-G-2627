# Porta do n8n (o workflow de alerta de stock chama http://localhost:5678)
N8N_PORT=5678

# Mantém os endpoints em /api/... e permite ler o Moloni a partir de $env
N8N_ENDPOINT_WEBHOOK=api
N8N_BLOCK_ENV_ACCESS_IN_NODE=false

# Encripta as credenciais do n8n. Guardar uma cópia segura: sem ela, não se recuperam.
N8N_ENCRYPTION_KEY=

GENERIC_TIMEZONE=Europe/Lisbon

# Moloni ON
MOLONI_API_URL=https://api.molonion.pt/v1
MOLONI_COMPANY_ID=
