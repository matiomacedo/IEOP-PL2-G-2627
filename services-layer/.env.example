# Variáveis do n8n (local e alojado)
N8N_PORT=5678
N8N_LISTEN_ADDRESS=0.0.0.0
N8N_ENDPOINT_WEBHOOK=api
N8N_BLOCK_ENV_ACCESS_IN_NODE=true
GENERIC_TIMEZONE=Europe/Lisbon
EXECUTIONS_DATA_PRUNE=true
EXECUTIONS_DATA_MAX_AGE=168
# Remove rapidamente os dados de execução já descartados
EXECUTIONS_DATA_HARD_DELETE_BUFFER=0
EXECUTIONS_DATA_PRUNE_HARD_DELETE_INTERVAL=1

# Encripta as credenciais do n8n. Guardar uma cópia segura: sem ela, não se recuperam.
N8N_ENCRYPTION_KEY=

# Lidas apenas por scripts/prepararImportacao.js
MOLONI_API_URL=https://api.molonion.pt/v1
MOLONI_COMPANY_ID=

# Base de dados partilhada (Supabase): retirar os comentários
# DB_TYPE=postgresdb
# DB_POSTGRESDB_HOST=
# DB_POSTGRESDB_PORT=5432
# DB_POSTGRESDB_DATABASE=postgres
# DB_POSTGRESDB_USER=
# DB_POSTGRESDB_PASSWORD=
# DB_POSTGRESDB_SSL_ENABLED=true

# Apenas no Render
# N8N_WEBHOOK_URL=https://<servico>.onrender.com/
# N8N_PROTOCOL=https
# N8N_PROXY_HOPS=1
